{
  "name": "Student Monitor Server",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "Student Monitor",
      "visibility": "public",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "CLASS_CODE": "${localEnv:CLASS_CODE}",
    "TEACHER_KEY": "${localEnv:TEACHER_KEY}",
    "PORT": "5000"
  },
  "postStartCommand": "bash .devcontainer/post-start.sh"
}